{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch (Windows MSVC)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Debug/CleanBomberman.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build/Debug",
      "environment": [],
      "console": "externalTerminal"
    },
    {
      "name": "Launch (Linux GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/CleanBomberman",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
